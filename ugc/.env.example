DEVELOPMENT_MODE=True

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
CACHE_EXPIRE_IN_SECONDS=300 # 5 minutes

SERVICE_URL=http://localhost:8000

AUTHJWT_SECRET_KEY=your_secret_key_more_than_32_characters_long
AUTHJWT_ALGORITHM=HS256

SUBSCRIBER_ROLE_NAME=subscriber
ADMIN_ROLE_NAME=admin

OTEL_TRACES_ENDPOINT=http://localhost:4318/v1/traces
OTEL_CONSOLE_EXPORT_ENABLED=False

# MongoDB connection details
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=ugc_database
MONGODB_ROOT_USERNAME=mongo
MONGODB_ROOT_PASSWORD=mongo_password
MONGODB_REPLICA_SET=rs0
MONGODB_EXTERNAL_PORT=27017