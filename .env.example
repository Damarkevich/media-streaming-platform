SECRET_KEY=django-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

AUTH_API_LOGIN_URL=http://movies-auth:8000/api/v1/auth/api-login

# Postgres connection details
POSTGRES_DB=movies_database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123qwe
SQL_HOST=movies-db
SQL_PORT=5432
SQL_OPTIONS=-c search_path=public,content

BATCH_SIZE=10

# Elasticsearch connection details
ES_HOST=movies-elasticsearch
ES_PORT=9200
ES_USER=elastic
ES_PASSWORD=changeme

# ELK local development
ELK_INDEX_PATTERN=docker-logs-*
ELK_KIBANA_PORT=5601
ELK_LOGSTASH_BEATS_PORT=5044
ELK_ES_PORT=9201

# Redis connection details
REDIS_HOST=movies-redis
REDIS_PORT=6379
REDIS_DB=0

# MongoDB connection details
MONGODB_HOST=movies-mongodb
MONGODB_PORT=27017
MONGODB_DATABASE=ugc_database
MONGODB_ROOT_USERNAME=mongo
MONGODB_ROOT_PASSWORD=mongo_password
MONGODB_EXTERNAL_PORT=27017

# Tracing exporter (OTLP/HTTP)
OTEL_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_CONSOLE_EXPORT_ENABLED=False

# Sentry / GlitchTip error tracking
SENTRY_DSN=

# GlitchTip database
GLITCHTIP_DB_USER=sentry
GLITCHTIP_DB_PASSWORD=sentry_password
GLITCHTIP_DB_NAME=sentry

# GlitchTip application
GLITCHTIP_DATABASE_URL=postgresql://sentry:sentry_password@sentry-db/sentry
GLITCHTIP_REDIS_URL=redis://movies-redis:6379/1
GLITCHTIP_SECRET_KEY=glitchtip-very-secret-key-change-me
GLITCHTIP_EMAIL_URL=consolemail://
GLITCHTIP_DOMAIN=http://localhost:8007
GLITCHTIP_DEFAULT_AUTO_FIELD=django.db.models.BigAutoField
GLITCHTIP_CELERY_WORKER_AUTOSCALE=1,3

# Logging configuration
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
LOG_NAME=etl_postgres_to_elasticsearch

SESSION_SECRET_KEY=your_session_secret_key_more_than_32_characters_long

#  Google OAuth2.0 credentials
GOOGLE_CLIENT_ID=google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Event Ingest Service settings
EVENT_INGEST_SERVICE_NAME=Event Ingest Service
EVENT_INGEST_SERVICE_DESCRIPTION=Event Ingest service for the Movies Streaming Platform
EVENT_INGEST_MAX_CONTENT_LENGTH=1048576 # 1 MB

# Kafka connection details
KAFKA_BOOTSTRAP_SERVERS='["kafka-0:9092","kafka-1:9092","kafka-2:9092"]'
KAFKA_API_VERSION='[3, 4]'
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_ACKS=all
KAFKA_RETRIES=3
KAFKA_TOPIC=events

# Kafka cluster
KAFKA_ENABLE_KRAFT=yes
ALLOW_PLAINTEXT_LISTENER=yes
KAFKA_KRAFT_CLUSTER_ID=abcdefghijklmnopqrstuv
KAFKA_CFG_PROCESS_ROLES=broker,controller
KAFKA_CFG_CONTROLLER_LISTENER_NAMES=CONTROLLER
KAFKA_CFG_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,EXTERNAL:PLAINTEXT,PLAINTEXT:PLAINTEXT
KAFKA_CFG_CONTROLLER_QUORUM_VOTERS=0@kafka-0:9093,1@kafka-1:9093,2@kafka-2:9093
KAFKA_CFG_NODE_ID_0=0
KAFKA_CFG_NODE_ID_1=1
KAFKA_CFG_NODE_ID_2=2
KAFKA_CFG_LISTENERS_0=PLAINTEXT://:9092,CONTROLLER://:9093,EXTERNAL://:9094
KAFKA_CFG_LISTENERS_1=PLAINTEXT://:9092,CONTROLLER://:9093,EXTERNAL://:9095
KAFKA_CFG_LISTENERS_2=PLAINTEXT://:9092,CONTROLLER://:9093,EXTERNAL://:9096
KAFKA_CFG_ADVERTISED_LISTENERS_0=PLAINTEXT://kafka-0:9092,EXTERNAL://127.0.0.1:9094
KAFKA_CFG_ADVERTISED_LISTENERS_1=PLAINTEXT://kafka-1:9092,EXTERNAL://127.0.0.1:9095
KAFKA_CFG_ADVERTISED_LISTENERS_2=PLAINTEXT://kafka-2:9092,EXTERNAL://127.0.0.1:9096

# Kafka UI
KAFKA_UI_BOOTSTRAP_SERVERS=kafka-0:9092
KAFKA_UI_CLUSTER_NAME=kraft

# ClickHouse credentials
CLICKHOUSE_DEFAULT_USER=default
CLICKHOUSE_DEFAULT_PASSWORD=change_me_default_password
CLICKHOUSE_ADMIN_USER=admin
CLICKHOUSE_ADMIN_PASSWORD=change_me_admin_password
CLICKHOUSE_TIMEZONE=UTC

# ETL Kafka -> ClickHouse settings
ETL_KAFKA_CLICKHOUSE_SERVICE_NAME=ETL Kafka ClickHouse service
ETL_KAFKA_CLICKHOUSE_SERVICE_DESCRIPTION=ETL Kafka ClickHouse service for media streaming platform
ETL_KAFKA_CLICKHOUSE_LOG_LEVEL=INFO
ETL_KAFKA_CLICKHOUSE_LOG_FORMAT=%(asctime)s - %(name)s - %(levelname)s - %(message)s
ETL_KAFKA_CLICKHOUSE_LOG_NAME=etl_kafka_clickhouse

# ClickHouse configuration
CLICKHOUSE_DEFAULT_USER=default
CLICKHOUSE_DEFAULT_PASSWORD=change_me_default_password

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=events
CLICKHOUSE_TABLE=user_events
CLICKHOUSE_CLUSTER_NAME=company_cluster
CLICKHOUSE_LOCAL_DATABASE=shard
CLICKHOUSE_SHARDING_KEY=cityHash64(user_id)

# Kafka consumer configuration
ETL_KAFKA_CLICKHOUSE_GROUP_ID=etl-kafka-clickhouse-group
ETL_KAFKA_CLICKHOUSE_AUTO_OFFSET_RESET=earliest
ETL_KAFKA_CLICKHOUSE_MAX_EXTRACT_BATCH_SIZE=100
ETL_KAFKA_CLICKHOUSE_POLL_TIMEOUT_MS=1000

# ClickHouse load configuration
ETL_KAFKA_CLICKHOUSE_MIN_LOAD_BATCH_SIZE=1000
ETL_KAFKA_CLICKHOUSE_BATCH_MAX_WAIT_SECONDS=5.0
ETL_KAFKA_CLICKHOUSE_IDLE_SLEEP_SECONDS=1.0
ETL_KAFKA_CLICKHOUSE_INSERT_MAX_RETRIES=3
ETL_KAFKA_CLICKHOUSE_INSERT_RETRY_BACKOFF_SECONDS=1.0
