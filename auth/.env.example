DEVELOPMENT_MODE=True

CORS_ORIGINS='["http://localhost:3000"]'

AUTHJWT_SECRET_KEY=your_secret_key_more_than_32_characters_long
AUTHJWT_TOKEN_LOCATION='["headers"]'
AUTHJWT_HEADER_NAME=Authorization
AUTHJWT_HEADER_TYPE=Bearer
AUTHJWT_DENYLIST_ENABLED=true
AUTHJWT_DENYLIST_TOKEN_CHECKS='["access", "refresh"]'
ACCESS_TOKEN_EXPIRES=300 # 5 minutes
REFRESH_TOKEN_EXPIRES=604800 # 7 days

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
PERMISSIONS_CACHE_TTL=60

POSTGRES_DB=auth_database
POSTGRES_USER=app
POSTGRES_PASSWORD=123qwe
POSTGRES_DB_SCHEMA=auth

SQL_HOST=localhost
SQL_PORT=6543
SQL_OPTIONS=-c search_path=auth,public
SQL_ECHO=True

SESSION_SECRET_KEY=your_session_secret_key_more_than_32_characters_long

#  Google OAuth2.0 credentials
GOOGLE_CLIENT_ID=google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

